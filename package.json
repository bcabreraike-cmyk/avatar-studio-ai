{\n  "name": "avatar-studio-ai",\n  "version": "0.1.0",\n  "description": "Local AI-powered avatar and content creation platform with unrestricted generation",\n  "private": true,\n  "type": "module",\n  "engines": {\n    "node": ">=24.0.0",\n    "pnpm": ">=11.22.0"\n  },\n  "packageManager": "pnpm@11.22.0",\n  "scripts": {\n    "dev": "turbo run dev --parallel",\n    "dev:backend": "turbo run dev --filter=backend",\n    "dev:frontend": "turbo run dev --filter=frontend",\n    "dev:orchestrator": "turbo run dev --filter=orchestrator",\n    "build": "turbo run build",\n    "test": "turbo run test",\n    "lint": "turbo run lint",\n    "setup:models": "node scripts/setup-models.mjs",\n    "setup:gpu": "node scripts/detect-gpu.mjs",\n    "setup:all": "pnpm install && pnpm run setup:gpu && pnpm run setup:models",\n    "clean": "turbo run clean && rm -rf node_modules",\n    "docker:build": "docker build -f docker/Dockerfile -t avatar-studio-ai .",\n    "docker:dev": "docker-compose -f docker/docker-compose.yml up"\n  },\n  "devDependencies": {\n    "@types/node": "^20.10.0",\n    "turbo": "^2.0.0",\n    "typescript": "^5.3.0"\n  }\n}