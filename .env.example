# Platform & GPU Detection (auto-detected, override if needed)\nPLATFORM=macos\nGPU_TYPE=metal\nGPU_DEVICE_ID=0\nUSE_CPU_FALLBACK=true\n\n# Memory & Performance\nMAX_MEMORY_MB=8192\nMAX_WORKERS=4\nBATCH_SIZE=2\nDISABLE_GPU_OPTIMIZATION=false\n\n# Paths\nMODELS_PATH=./models\nDATA_PATH=./data\nOUTPUT_PATH=./output\nLOGS_PATH=./logs\n\n# Backend\nBACKEND_PORT=3000\nBACKEND_HOST=localhost\nDATABASE_URL=file:./data/app.db\nREDIS_URL=redis://localhost:6379\n\n# Frontend\nFRONTEND_PORT=3001\nVITE_API_URL=http://localhost:3000\n\n# Logging\nLOG_LEVEL=info\nLOG_FORMAT=json\n\n# Optional: External APIs (leave empty for local models)\nOPENAI_API_KEY=\nHUGGINGFACE_API_KEY=\n